<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="10dp"
    app:cardBackgroundColor="@color/jar_glass"
    app:cardCornerRadius="6dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/recipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:fontFamily="@font/app_handwritten"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="Garlic Butter Pasta" />

        <!-- The red line across the top of a real index card -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:background="@color/card_rule" />

        <TextView
            android:id="@+id/recipeHaveAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/fresh_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="✓ All 5 ingredients on your shelf" />

        <TextView
            android:id="@+id/recipeIngredients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            tools:text="Pasta · Butter · Garlic · Cheddar · Onion" />

        <TextView
            android:id="@+id/recipeMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="25 min · Serves 2" />

        <!-- Only shown when the recipe uses food that expires soon -->
        <TextView
            android:id="@+id/recipeUsesUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/soon_fill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/soon_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Uses up your Cheddar"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>