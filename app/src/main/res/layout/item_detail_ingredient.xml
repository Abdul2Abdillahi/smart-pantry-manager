<?xml version="1.0" encoding="utf-8"?>
<!-- One ingredient row: mark, name with "you have" line, amount needed -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/ingredientMark"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="✓" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ingredientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp"
            tools:text="Pasta" />

        <TextView
            android:id="@+id/ingredientHave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            tools:text="You have 400 g" />
    </LinearLayout>

    <TextView
        android:id="@+id/ingredientAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="200 g" />
</LinearLayout>