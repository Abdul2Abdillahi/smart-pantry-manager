<?xml version="1.0" encoding="utf-8"?>
<!-- Nunito Sans is a variable font: one file containing every weight.
     This tells Android which weight to use for normal and for bold text. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/nunito_sans"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        app:font="@font/nunito_sans"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/nunito_sans"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"
        app:font="@font/nunito_sans"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:fontVariationSettings="'wght' 700" />
</font-family>